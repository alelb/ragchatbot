# Copy this file to .env and pick ONE of the two setups below.

# Option A - Claude via the Anthropic API (requires a paid API key)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option B - local model via Ollama (no API key needed; `ollama serve` must be running
# and the model pulled, e.g. `ollama pull gemma4`)
LLM_BASE_URL=http://localhost:11434
ANTHROPIC_MODEL=gemma4
