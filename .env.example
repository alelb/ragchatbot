# Copy this file to .env and pick ONE of the two setups below.

# Option A - Claude via the Anthropic API (requires a paid API key)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option B - local model via Ollama (no API key needed; `ollama serve` must be running).
# gemma4-8k is gemma4 with an 8192-token context (see Modelfile); Ollama's default window
# (often 4096) is too small for two tool rounds. Create it once with:
#   ollama pull gemma4 && ollama create gemma4-8k -f Modelfile
LLM_BASE_URL=http://localhost:11434
ANTHROPIC_MODEL=gemma4-8k
